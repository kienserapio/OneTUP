# OneTUP — copy to .env and fill in.
# This file is the single source of truth for secrets. `pnpm env` derives
# apps/web/.env.local and apps/worker/.env from it.

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_CONNECTION_STRING=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Optional: pin the IPv4 session pooler host if region probing is slow.
# SUPABASE_POOLER_HOST=aws-0-ap-southeast-1.pooler.supabase.com

# --- AI provider (server-side only, ADR-006) ------------------------------
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter's free tier is 20 requests a minute and — this is the one that
# bites — 50 requests a DAY for an account that has never bought credits. One
# assistant question costs two of those (route, then answer), and every model
# the ladder falls through costs another. Buying 10 credits once, permanently,
# raises the daily cap to 1000. Nothing else about the account changes.
#   https://openrouter.ai/docs/api-reference/limits

# Model ladders. Comma-separated, tried in order on failure or rate limit.
# Changing a model is an environment edit, never a code change.
#
# Order these by what actually answers, not by parameter count. Free capacity is
# shared and models rate-limit upstream without warning, so a long ladder is the
# whole point: put a fast, reliable model first and let the rest be the fallback
# it exists to be.
AI_TIER_FAST=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-3-nano-30b-a3b:free,openai/gpt-oss-20b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
AI_TIER_STANDARD=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,openai/gpt-oss-20b:free,nvidia/nemotron-3-nano-30b-a3b:free
AI_TIER_LONG=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free
AI_TIER_REASON=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free
AI_TIER_VISION=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-12b-v2-vl:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# --- Sync worker (ADR-004) ------------------------------------------------
# The worker never receives Supabase credentials. Only this shared secret.
WORKER_URL=http://localhost:8787
WORKER_SECRET=change-me-and-rotate-quarterly
WORKER_PORT=8787
ERS_BASE_URL=https://ers.tup.edu.ph/aims/students/
WORKER_MAX_CONCURRENCY=10
WORKER_JOB_TIMEOUT_MS=60000

# --- Web Push (generate with `npx web-push generate-vapid-keys`) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@onetup.ph

# --- Site -----------------------------------------------------------------
SITE_URL=http://localhost:3000
# Public repository. Until this is set, the "view the source" links in the
# footer render as plain text rather than as links to nowhere.
NEXT_PUBLIC_REPO_URL=https://github.com/kienserapio/OneTUP

# Base URL of the 360 campus tour (TUPniverse, hosted on Panoee). Scene ids
# come from campus_places.tour_scene_url. Unset renders an honest empty state.
NEXT_PUBLIC_CAMPUS_TOUR_URL=https://tour.panoee.net/692f8f863b0c0b7687f91593
